# HTTP
PORT=8080
WEB_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/as_storagebox

# JWT validation. In production use a long random secret or migrate to an
# asymmetric/JWKS identity provider without changing route authorization logic.
JWT_SECRET=change-me-to-a-long-random-secret

# S3-compatible object storage. Works with providers exposing the S3 API.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=as-storagebox
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Upload limits enforced before a signed upload operation is issued.
MAX_UPLOAD_BYTES=1073741824
SIGNED_URL_TTL_SECONDS=900
